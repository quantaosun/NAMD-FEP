#!/usr/bin/env python3
"""Entry point for the `rbfe` command.

Add `bin/` to PATH once (see RUNBOOK.md section 1) and every pipeline step is
`rbfe <step>` from inside a system directory.
"""

import sys
from pathlib import Path

# The repo root, so `import rbfe` works without an install.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from rbfe.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
